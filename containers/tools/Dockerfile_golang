FROM ubuntu:latest

# We remove apt/lists here to cut down on image size
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    ca-certificates \
    wget \
    git  \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV GOLANG_VERSION=1.23.0

RUN curl -OL https://go.dev/dl/go${GOLANG_VERSION}.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go${GOLANG_VERSION}.linux-amd64.tar.gz \
    && rm go${GOLANG_VERSION}.linux-amd64.tar.gz

ENV PATH="/usr/local/go/bin:${PATH}"

# There's no need to add the gofer CLI; Gofer puts its own binary in every task, at /gofer/bin/gofer.

# By default, just display the Go version
CMD ["go", "version"]
